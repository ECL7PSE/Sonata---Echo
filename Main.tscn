[sub_resource type="RectangleShape2D" id="RectangleShape2D_r0du0"]
# FEET, not body. The Icon is a 64x64 sheet at hframes/vframes 4, so one frame is
# 16x16 and at scale 1.2 it draws 19.2x19.2 rendered px. This rect used to be
# 43x67 - 1.34 tiles wide and 2.1 tiles tall, i.e. more than twice the visible
# character in every direction - which is why a 3-wide corridor felt like a
# 1-tile squeeze and why coins near a wall could not be walked into range of.
# 20x16 sits inside the drawn feet (sprite spans y -9.6..+9.6), and `position`
# below drops it to the base of that span.
size = Vector2(20, 16)

[sub_resource type="CircleShape2D" id="CircleShape2D_jsssl"]
radius = 17.20465

[node name="Node2D" type="Node2D" unique_id=252827031]

[node name="Dungeon" parent="." unique_id=1459863182 instance=ExtResource("4_dungeon")]

[node name="Player(CharacterBody2D)" type="CharacterBody2D" parent="." unique_id=2091494280]
# Draw order only, no collision change. z_as_relative MUST be false here: the
# player is a sibling of Dungeon, not a child of it, so its z_index is measured
# from the canvas rather than from a parent. Left relative, z_index 3 would
# still resolve against the default 0 and the player would stay under the wall
# cap at z 1 - which is exactly the bug this fixes.
z_index = 3
z_as_relative = false
script = ExtResource("1_uu6xs")

[node name="Icon(Sprite2D)" type="Sprite2D" parent="Player(CharacterBody2D)" unique_id=721354121]
scale = Vector2(1.2, 1.2)
texture = ExtResource("2_cm0pq")
hframes = 4
vframes = 4
frame = 4

[node name="CollisionShape2D" type="CollisionShape2D" parent="Player(CharacterBody2D)" unique_id=1725347124]
# y=2 puts the 16px-tall box on the feet: the sprite's lower edge is at +9.6, so
# a centred 16px box there spans y -6..+10. The old (-2, 1) was centred on the
# body and only made sense for the old 43x67 rect.
position = Vector2(0, 2)
shape = SubResource("RectangleShape2D_r0du0")

[node name="AttackArea(Area2D)" type="Area2D" parent="Player(CharacterBody2D)" unique_id=400335431]
position = Vector2(0, 18)

[node name="CollisionShape2D" type="CollisionShape2D" parent="Player(CharacterBody2D)/AttackArea(Area2D)" unique_id=2010123661]
position = Vector2(0, 8)
shape = SubResource("CircleShape2D_jsssl")

